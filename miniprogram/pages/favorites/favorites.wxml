<!-- 我的收藏 -->
<view class="empty" wx:if="{{isEmpty}}">
  <view class="empty-icon">☆</view>
  <view class="empty-text">还没有收藏内容</view>
  <view class="text-sub">在院校详情页可以收藏院校或专业组</view>
</view>

<view
  class="fav-item" wx:for="{{views}}" wx:key="id"
  data-id="{{item.id}}" data-code="{{item.code}}"
  hover-class="item-hover" bindtap="openItem" bindlongpress="removeItem"
>
  <view class="fav-badge">{{item.typeText}}</view>
  <view class="fav-body">
    <view class="fav-name">{{item.name}}</view>
    <view class="fav-majors" wx:if="{{item.majorsText}}">{{item.majorsText}}</view>
    <view class="fav-meta">
      代码 {{item.code}}<text wx:if="{{item.groupText}}"> · {{item.groupText}}</text>
      · 收藏于 {{item.savedText}}
    </view>
  </view>
  <view class="fav-arrow">›</view>
</view>

<view class="tip" wx:if="{{!isEmpty}}">长按可取消收藏，点击查看院校详情</view>
