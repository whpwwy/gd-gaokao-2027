/* 志愿推荐表单 */
.mode-switch {
  display: flex; background: var(--bg);
  border-radius: 36rpx; padding: 6rpx; margin-bottom: 24rpx;
}
.mode-item {
  flex: 1; text-align: center; padding: 16rpx 0;
  border-radius: 32rpx; font-size: 28rpx; color: var(--text-sub);
}
.mode-item.active { background: #fff; color: var(--primary); font-weight: 500; }

.big-input {
  background: var(--bg); border-radius: 12rpx;
  padding: 26rpx 24rpx; font-size: 40rpx;
}
.input-hint { font-size: 24rpx; color: var(--text-sub); margin-top: 16rpx; }
.hint-num { color: var(--primary); font-weight: 600; }

.card-label { font-size: 26rpx; color: var(--text-sub); margin-bottom: 16rpx; }

.seg-row, .chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.seg-item, .chip {
  padding: 14rpx 34rpx; border-radius: 30rpx;
  background: var(--bg); color: var(--text-sub);
  font-size: 26rpx; border: 1rpx solid transparent;
}
.seg-item.active, .chip.on {
  background: var(--primary-light); color: var(--primary);
}

.kw-input {
  background: var(--bg); border-radius: 12rpx;
  padding: 22rpx 24rpx; font-size: 28rpx;
}

.generate-wrap { padding: 12rpx 32rpx 60rpx; }
.generate-note {
  font-size: 22rpx; color: var(--text-sub);
  text-align: center; margin-top: 20rpx; line-height: 1.6;
}
