/* 位次查询 */
.form-label { font-size: 26rpx; color: var(--text-sub); margin-bottom: 16rpx; }
.form-input {
  background: var(--bg); border-radius: 12rpx;
  padding: 22rpx 24rpx; font-size: 34rpx;
}
.year-tabs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.year-tab {
  padding: 12rpx 32rpx; border-radius: 28rpx;
  background: var(--bg); color: var(--text-sub); font-size: 26rpx;
}
.year-tab.active { background: var(--primary); color: #fff; }

/* 结果 */
.result-card { text-align: center; }
.result-tip { font-size: 28rpx; color: var(--text-sub); }
.result-rank {
  font-size: 88rpx; font-weight: 600; color: var(--primary);
  line-height: 1.3; margin: 16rpx 0;
}
.result-unit { font-size: 30rpx; font-weight: 400; margin-left: 8rpx; }
.result-note { font-size: 22rpx; color: var(--text-sub); }

/* 同位分表 */
.section-title {
  font-size: 30rpx; font-weight: 500;
  margin: 12rpx 32rpx 0;
}
.eq-card { padding-top: 12rpx; padding-bottom: 24rpx; }
.eq-row {
  display: flex; align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.eq-head { color: var(--text-sub); font-size: 24rpx; padding: 12rpx 8rpx; }
.eq-year { width: 25%; }
.eq-score { width: 40%; }
.eq-rank { width: 35%; text-align: right; }
.eq-tip {
  font-size: 22rpx; color: var(--text-sub);
  line-height: 1.6; margin-top: 20rpx;
}
