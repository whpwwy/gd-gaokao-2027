/* 推荐结果 */
.summary-card {
  background: #fff; margin: 24rpx; border-radius: 16rpx; padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(43, 108, 176, 0.06);
}
.summary-line { display: flex; }
.summary-item { flex: 1; text-align: center; }
.summary-num { font-size: 40rpx; font-weight: 600; color: var(--primary); }
.text-reach { color: var(--reach); }
.text-match { color: var(--match); }
.text-safety { color: var(--safety); }
.summary-label { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; }
/* 可点击的统计项（仅对应分区有结果时） */
.summary-item.can-tap { border-radius: 12rpx; }
.summary-hover { background: var(--bg); }

/* 空状态 */
.empty-box {
  text-align: center; padding: 100rpx 48rpx;
  color: var(--text-main); font-size: 28rpx;
}
.empty-hint { color: var(--text-sub); font-size: 24rpx; margin-top: 20rpx; }
.empty-btn { margin: 40rpx 80rpx 0; }

/* 分区标题（整个标题栏可点击折叠/展开） */
.tier-head {
  display: flex; align-items: center;
  padding: 16rpx 32rpx;
}
.tier-head-hover { background: var(--bg); }
.tier-title {
  font-size: 30rpx; font-weight: 600;
  width: 64rpx; height: 64rpx; line-height: 64rpx;
  border-radius: 50%; text-align: center; color: #fff;
  flex-shrink: 0;
}
.bg-reach { background: var(--reach); }
.bg-match { background: var(--match); }
.bg-safety { background: var(--safety); }
.tier-desc {
  font-size: 22rpx; color: var(--text-sub);
  margin-left: 16rpx; flex: 1;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.tier-count { font-size: 22rpx; color: var(--text-sub); margin-left: 16rpx; }
.tier-arrow {
  font-size: 24rpx; color: var(--text-sub);
  margin-left: 14rpx; width: 32rpx; text-align: center;
}
/* 折叠状态下与下一分区留出间距 */
.tier-section { padding-bottom: 8rpx; }

/* 候选卡片 */
.cand-card {
  background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(43, 108, 176, 0.06);
}
.card-hover { opacity: 0.85; }
.cand-top { display: flex; justify-content: space-between; align-items: center; }
.cand-name { font-size: 30rpx; font-weight: 500; flex: 1; padding-right: 16rpx; }
.prob-tag {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 24rpx;
}
.prob-high { background: var(--safety-bg); color: var(--safety); }
.prob-mid { background: var(--match-bg); color: var(--match); }
.prob-low { background: var(--reach-bg); color: var(--reach); }

.cand-tags { margin: 14rpx 0; }

.cand-mid {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--bg); border-radius: 12rpx; padding: 20rpx 24rpx;
}
.mid-group { font-size: 28rpx; font-weight: 500; display: flex; align-items: center; }

/* 帮助图标（点击查看专业组说明） */
.help-ico {
  display: inline-flex; align-items: center; justify-content: center;
  width: 30rpx; height: 30rpx; margin-left: 10rpx;
  border: 1rpx solid var(--text-sub); border-radius: 50%;
  font-size: 20rpx; color: var(--text-sub); line-height: 1;
}
.mid-majors { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mid-ref { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; }
.mid-margin { font-size: 26rpx; font-weight: 500; }
.tier-reach { color: var(--reach); }
.tier-match { color: var(--match); }
.tier-safety { color: var(--safety); }

.cand-bottom {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 18rpx;
}
.cand-history { font-size: 22rpx; color: var(--text-sub); flex: 1; }
.cand-fav {
  font-size: 40rpx; color: #cbd5e0; padding: 0 10rpx;
}
.cand-fav.faved { color: #ecc94b; }

.bottom-note {
  font-size: 22rpx; color: var(--text-sub);
  line-height: 1.7; padding: 24rpx 40rpx 60rpx;
}
